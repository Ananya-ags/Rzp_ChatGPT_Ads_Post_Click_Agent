{
  "name": "cosmos-engage-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx scripts/seed/index.ts",
    "pipelines": "tsx scripts/build-policies.ts && tsx scripts/pipelines/run.ts",
    "demo-cache": "tsx scripts/build-demo-cache.ts",
    "validate-data": "tsx scripts/validate-data.ts",
    "data": "npm run seed && npm run pipelines && npm run demo-cache && npm run validate-data",
    "typecheck": "tsc --noEmit",
    "ai:check": "tsx scripts/ai-check.ts",
    "models": "tsx scripts/list-models.ts",
    "policies": "tsx scripts/build-policies.ts",
    "evals": "tsx --conditions=react-server scripts/evals/run.ts",
    "evals:rejudge": "tsx --conditions=react-server scripts/evals/rejudge.ts",
    "test:claims": "tsx scripts/tests/claims.test.ts",
    "test:chips": "tsx --conditions=react-server scripts/tests/chips.test.ts",
    "test:chat-browser": "node scripts/tests/chat-browser.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/google": "^4.0.94",
    "@ai-sdk/react": "^4.0.140",
    "ai": "^7.0.137",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright": "^1.58.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
