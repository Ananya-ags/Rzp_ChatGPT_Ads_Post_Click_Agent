# Copy to .env.local and fill in. Never commit real keys.

# Razorpay Test Mode (dashboard.razorpay.com → Test Mode → API keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# LLM (agent at runtime + offline pipelines). Gemini is used when its key is set; Anthropic is the alternative.
# With neither, the agent falls back to its offline answers and the pipelines run in heuristic mode.
# Check your setup with `npm run ai:check` (never prints the key).
GOOGLE_GENERATIVE_AI_API_KEY=
# Model IDs default to the values in src/lib/ai/model.ts; set these only to override.
# Agent main / fallback, offline pipelines, eval judge. List what your key can call with `npm run models`.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_PIPELINE_MODEL=gemini-3.8-flash
GEMINI_PIPELINE_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-pro-latest
ANTHROPIC_API_KEY=

# Spending guards. Above this estimated daily LLM spend (USD, tokens × list price) the chat switches to quick
# answers until the next day (per server instance). Total project budget: ₹300 (~$3.50).
LLM_DAILY_BUDGET_USD=1.50
# Video recording only: open any page with ?demo=<token> to get a session cookie that skips the chat rate limit.
# Use a long random value; never share it or put it in a link you send.
DEMO_BYPASS_TOKEN=
