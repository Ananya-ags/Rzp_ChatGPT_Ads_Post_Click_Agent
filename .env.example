# Copy to .env.local and fill in. Never commit real keys.

# Razorpay Test Mode (dashboard.razorpay.com → Test Mode → API keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# LLM (agent at runtime + offline pipelines). Without it, the agent falls back to cached demo responses
# and pipelines run in heuristic mode.
ANTHROPIC_API_KEY=

